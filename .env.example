# Nothing here is required for the demo. Values never leave this file's local copy:
# not in chat, not in commits, not in a screen recording.
TALOS_DECIDER=jev          # off | rules | jev | river; jev falls back to rules automatically
JEV_API_KEY=               # v1 decider, optional
JEV_MODEL=jev-1.13         # pin one version; never "latest"
OPENROUTER_API_KEY=        # alternative route to jev-1.13 if the TypeSafe waitlist has not cleared
RIVER_API_KEY=             # v2 fine-tune, optional
QM_DIR=                    # where QM is checked out, if the QM adapter is used
